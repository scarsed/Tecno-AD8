# TWRP Recovery USB Initialization for MediaTek Devices
# Fixes ADB, MTP, and Fastboot functionality

on early-init
    # Initialize USB controller (MediaTek-specific)
    write /sys/module/musb_hdrc/parameters/kernel_init_done 1
    setprop sys.usb.configfs 0

on post-fs
    # Set up USB gadget via configfs
    mkdir /config 0770 shell shell
    mount configfs none /config
    mkdir /config/usb_gadget/g1 0770 shell shell

    # Basic USB device info
    write /config/usb_gadget/g1/idVendor 0x18D1  # Google VID
    write /config/usb_gadget/g1/idProduct 0xD001  # Default ADB PID
    write /config/usb_gadget/g1/bcdDevice 0x0223
    write /config/usb_gadget/g1/bcdUSB 0x0200

    # USB strings
    mkdir /config/usb_gadget/g1/strings/0x409 0770
    write /config/usb_gadget/g1/strings/0x409/serialno "${ro.serialno}"
    write /config/usb_gadget/g1/strings/0x409/manufacturer "${ro.product.manufacturer}"
    write /config/usb_gadget/g1/strings/0x409/product "${ro.product.model}"

    # Create supported functions
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /config/usb_gadget/g1/functions/ffs.fastboot

    # Create configuration
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 500

    # Mount functionfs for each mode
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb
    mkdir /dev/usb-ffs/mtp 0770 mtp mtp
    mount functionfs mtp /dev/usb-ffs/mtp
    mkdir /dev/usb-ffs/fastboot 0770 system system
    mount functionfs fastboot /dev/usb-ffs/fastboot

on boot
    # Final USB setup
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"  # Adjust if using "mtu3" instead

    # For MTP performance
    write /sys/class/android_usb/android0/f_mtp/cpu_mask 0x80
    write /sys/module/usb_f_mtp/parameters/mtp_rx_cont 1

    # USB OTG detection
    write /sys/module/block/parameters/events_dfl_poll_msecs 1000

# Cleanup when USB is disconnected
on property:init.svc.adbd=stopped
    setprop sys.usb.ffs.ready 0

on property:sys.usb.config=none && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/UDC "none"
    stop adbd
    stop fastbootd
    setprop sys.usb.ffs.ready 0

### ADB Mode ###
on property:sys.usb.config=adb && property:sys.usb.configfs=1
    setprop sys.usb.pid 0xD001
    write /config/usb_gadget/g1/idProduct 0xD001
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    start adbd

### Fastboot Mode ###
on property:sys.usb.config=fastboot && property:sys.usb.configfs=1
    setprop sys.usb.pid 0x4EE0
    write /config/usb_gadget/g1/idProduct 0x4EE0
    symlink /config/usb_gadget/g1/functions/ffs.fastboot /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    start fastbootd

### MTP Mode ###
on property:sys.usb.config=mtp && property:sys.usb.configfs=1
    setprop sys.usb.pid 0x2008
    write /config/usb_gadget/g1/idProduct 0x2008
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}

### MTP + ADB Mode ###
on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    setprop sys.usb.pid 0x201D
    write /config/usb_gadget/g1/idProduct 0x201D
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    start adbd
